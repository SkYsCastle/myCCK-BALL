#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };
/ {
    // 上下滚动编码器行为
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };


    combos {
        compatible = "zmk,combos";

        combo_leftclick {
            bindings = <&mkp MB1>;
            key-positions = <25 26>;
        };

        combo_midclick {
            bindings = <&mkp MB3>;
            key-positions = <26 27>;
        };

        combo_rightclick {
            bindings = <&mkp MB2>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1           &kp N2           &kp N3             &kp N4                   &kp N5  &kp N6   &kp N7             &kp N8               &kp N9            &kp N0                    &kp BACKSPACE
&kp GRAVE         &kp Q            &kp W            &kp E              &kp R                    &kp T   &kp Y    &kp U              &kp I                &kp O             &kp P                     &kp BSLH
&kp TAB           &ht_left LCMD A  &ht_left LALT S  &ht_left LSHFT D   &ht_left LEFT_CONTROL F  &kp G   &kp H    &ht_right RCTRL J  &ht_right RSHFT K    &ht_right LALT L  &ht_right RCMD SEMICOLON  &kp SQT
&kp LEFT_SHIFT    &kp Z            &kp X            &kp C              &kp V                    &kp B   &kp N    &kp M              &mm_cm_sc            &mm_pr_col        &mm_qm_ex                 &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN     &kp LEFT_ALT     &td_spc_scrl_slow  &td_clk                  &td_bs  &kp DEL  &kp ENTER          &td_space_nav_mouse  &kp MINUS         &kp EQUAL                 &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW &inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        NUM {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans         &kp PLUS         &mm_f7  &mm_f8      &mm_f9  &mm_f10  &trans
&none   &none     &none     &none      &none      &none          &kp KP_MINUS     &mm_f4  &mm_f5      &mm_f6  &mm_f11  &trans
&trans  &kp LGUI  &KP LALT  &KP LSHFT  &kp LCTRL  &kp BACKSPACE  &kp KP_MINUS     &mm_f1  &mm_f2      &mm_f3  &mm_f12  &trans
&none   &none     &kp X     &none      &none      &kp DEL        &kp KP_multiply  &kp N0  &kp KP_DOT  &trans  &trans   &trans
&trans  &trans    &trans    &trans     &trans     &trans         &trans           &trans  &kp SPACE   &trans  &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT RIGHT>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        NAV {
            bindings = <
&kp F12  &kp F1  &kp F2          &kp F3          &kp F4           &kp F5  &kp F6  &kp F7          &kp F8    &kp F9           &kp F10    &Kp F11
&trans   &trans  &trans          &mmv MOVE_UP    &trans           &trans  &trans  &trans          &kp UP    &trans           &trans     &trans
&kp TAB  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW  &trans     &trans
&trans   &trans  &trans          &trans          &trans           &trans  &trans  &kp HOME        &kp END   &kp PG_UP        &kp PG_DN  &trans
&trans   &trans  &trans          &trans          &trans           &trans  &trans  &trans          &trans    &trans           &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW &inc_dec_kp PG_UP PG_DN>;
        };

        SYM {
            bindings = <
&trans     &trans    &trans   &trans   &trans      &trans     &trans        &trans      &trans    &trans    &trans     &trans
&kp TILDE  &kp AT    &kp f13  &kp f14  &kp AMPS    &kp UNDER  &kp PLUS      &kp AMPS    &kp LBKT  &kp RBKT  &kp PRCNT  &kp BSLH
&kp GRAVE  &kp HASH  &kp f15  &kp f16  &kp LS(N6)  &kp UNDER  &kp KP_MINUS  &kp LS(N6)  &kp LPAR  &kp RPAR  &kp ASTRK  &kp PIPE
&kp DLLR   &none     &kp LT   &kp GT   &kp CARET   &kp MINUS  &kp EQUAL     &kp UNDER   &kp LBRC  &kp RBRC  &kp AT     &kp FSLH
&trans     &trans    &trans   &trans   &trans      &trans     &trans        &trans      &trans    &trans    &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &to 0   &mkp MB4  &mkp MB5  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT RIGHT>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        slow {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans    &trans    &trans    &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans    &trans    &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans    &trans    &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans    &trans    &trans  &trans  &trans
&trans      &trans        &trans        &trans        &mkp MB4      &mkp MB5      &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT RIGHT>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };
};
